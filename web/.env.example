VITE_API_BASE_URL=
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_MAPS_API_KEY=
VITE_SENTRY_DSN=
# Dev only: set to true to answer the planner chat with a built-in mock reply
# (about one second delay; a message containing "fail" returns an error) instead
# of calling POST /api/v1/chat. Ignored in production builds. Leave false to use
# the real backend.
VITE_USE_MOCK_CHAT=false
