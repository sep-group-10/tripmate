<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The Flutter tool requires INTERNET in debug so it can talk to the
         running app (hot reload, debugger). -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Debug builds only: allow plain-HTTP calls to the local backend
         (http://10.0.2.2:8000). Release and profile builds keep the default
         and block cleartext traffic. -->
    <application android:usesCleartextTraffic="true"/>
</manifest>
